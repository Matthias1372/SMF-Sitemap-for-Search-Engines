<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE package-info SYSTEM "https://www.simplemachines.org/xml/package-info.dtd">

<package-info
    id="matthiasfeik:sitemapforsearchengines"
    version="1.0.0"
    xmlns="http://www.simplemachines.org/xml/package-info">

	<name>Sitemap for Search Engines</name>
	<version>1.0.0</version>
	<type>modification</type>
	
	<install for="2.1 - 2.1.*">
		<!-- Files -->
		<require-file name="Sources/Sitemap.php" destination="$sourcedir" />
		<require-dir name="Sources/Sitemap-Ext" destination="$sourcedir" />
		<require-file name="Themes/default/Sitemap.template.php" destination="$themedir" />
		<require-dir name="Themes/default/languages" destination="$themedir" />
		<!-- Hooks -->
		<hook hook="integrate_actions" function="SitemapActions" file="$sourcedir/Sitemap.php" />
		<hook hook="integrate_general_mod_settings" function="SitemapGeneralModSettings" file="$sourcedir/Sitemap.php" />
		<!-- Install script -->
		<code>add_settings.php</code>
	</install>
	
	<uninstall for="2.1 - 2.1.*">
		<!-- Remove files and folders -->
		<remove-file name="$sourcedir/Sitemap.php" />
		<remove-dir name="$sourcedir/Sitemap-Ext" />
		<remove-file name="$themedir/Sitemap.template.php" />
		<remove-dir name="$themedir/languages" />
		<!-- Remove hooks -->
		<hook hook="integrate_actions" function="SitemapActions" file="$sourcedir/Sitemap.php" reverse="true" />
		<hook hook="integrate_general_mod_settings" function="SitemapGeneralModSettings" file="$sourcedir/Sitemap.php" reverse="true" />
		<!-- Uninstall script -->
		<code>remove_settings.php</code>
	</uninstall>
</package-info>
