<?xml version="1.0" encoding="UTF-8"?>
<package-info xmlns="http://www.simplemachines.org/xml/package-info">
	<id>matthiasfeik:sitemapforsearchengines</id>
	<name>Sitemap for Search Engines</name>
	<version>1.1.0</version>
	<type>modification</type>

	<install for="2.1 - 2.1.99">
		<require-file name="Sources/Sitemap.php" destination="$sourcedir" />
		<require-file name="Sources/Sitemap.subs.php" destination="$sourcedir" />
		<require-file name="Sources/Sitemap-Ext/Boards.php" destination="$sourcedir/Sitemap-Ext" />
		<require-file name="Sources/Sitemap-Ext/Topics.php" destination="$sourcedir/Sitemap-Ext" />
		<require-file name="Themes/default/languages/Sitemap.english.php" destination="$themes_dir/default/languages" />
		<require-file name="Themes/default/languages/Sitemap.german.php" destination="$themes_dir/default/languages" />
		<require-file name="Themes/default/languages/Sitemap.german_informal.php" destination="$themes_dir/default/languages" />
		<hook hook="integrate_actions" function="SitemapActions" file="$sourcedir/Sitemap.php" />
		<hook hook="integrate_general_mod_settings" function="SitemapGeneralModSettings" file="$sourcedir/Sitemap.php" />
		<hook hook="integrate_buffer" function="SitemapBuffer" file="$sourcedir/Sitemap.php" />
		<code>add_settings.php</code>
	</install>

	<uninstall for="2.1 - 2.1.99">
		<code>remove_settings.php</code>
		<hook hook="integrate_buffer" function="SitemapBuffer" file="$sourcedir/Sitemap.php" reverse="true" />
		<hook hook="integrate_general_mod_settings" function="SitemapGeneralModSettings" file="$sourcedir/Sitemap.php" reverse="true" />
		<hook hook="integrate_actions" function="SitemapActions" file="$sourcedir/Sitemap.php" reverse="true" />
		<remove-file name="$sourcedir/Sitemap-Ext/Boards.php" />
		<remove-file name="$sourcedir/Sitemap-Ext/Topics.php" />
		<remove-file name="$themes_dir/default/languages/Sitemap.english.php" />
		<remove-file name="$themes_dir/default/languages/Sitemap.german.php" />
		<remove-file name="$themes_dir/default/languages/Sitemap.german_informal.php" />
		<remove-file name="$sourcedir/Sitemap.php" />
		<remove-file name="$sourcedir/Sitemap.subs.php" />
	</uninstall>
</package-info>
